{
  "name": "oddy-dataverse",
  "version": "0.12.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "@wxt-dev/module-react": {
      "@vitejs/plugin-react": "5.1.4"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.1.32",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "5.1.4",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^4.1.12",
    "wxt": "^0.21.4"
  }
